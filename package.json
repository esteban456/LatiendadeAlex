{
  "name": "tienda-de-alex",
  "version": "1.0.0",
  "private": true,
  "description": "La Tienda de Alex - tienda online en HTML, CSS y JS con pago con Mercado Pago",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "scrape": "node scripts/scrape.mjs",
